---
import "../styles/site.css";

var title = Astro.props.title || "xImporter";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
</head>
<body>
  <header>
    <div class="brand">
      <strong>xImporter</strong>
      <span class="beta">BETA</span>
    </div>
    <nav>
      <a href="/">Inicio</a>
      <a href="/instalar">Instalación</a>
    </nav>
  </header>
  <main>
    <p class="beta-banner">BETA. Esta versión no se ha probado en un Premiere real.</p>
    <slot />
  </main>
  <footer>
    <p>Panel interno para Premiere Pro. BETA: no se ha probado en Premiere real. No hay pagos ni licencias.</p>
    <p>Terceros: yt-dlp, ffmpeg (estos binarios estáticos incluyen x264, GPL) y Deno.</p>
  </footer>
</body>
</html>
